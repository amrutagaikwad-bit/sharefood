generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  name           String
  email          String           @unique
  password       String
  role           Role
  phone          String?
  isBlocked      Boolean          @default(false)
  isBanned       Boolean          @default(false)
  lastLoginAt    DateTime?
  donations      Donation[]       @relation("DonorDonations")
  loginHistory   LoginHistory[]
  sessions       UserSession[]
  pickupRequests Request[]        @relation("ReceiverRequests")
  notifications  Notification[]
  activityLogs   ActivityLog[]
  adminLogs      AdminLog[]       @relation("AdminActions")
  savedDonations SavedDonation[]
  reports        Report[]         @relation("Reporter")
  reportedOn     Report[]         @relation("ReportedUser")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
}

model Donation {
  id                  Int              @id @default(autoincrement())
  donorId             Int
  donor               User             @relation("DonorDonations", fields: [donorId], references: [id])
  foodName            String
  category            String           @default("Other")
  quantity            String
  servesCount         Int              @default(1)
  servingsRemaining   Int              @default(1)
  description         String?
  image               String?
  latitude            Float
  longitude           Float
  address             String
  city                String?
  state               String?
  postalCode          String?
  specialInstructions String?
  contactPhone        String?
  preparationAt       DateTime?
  expiryTime          DateTime
  pickupStart         DateTime?
  pickupEnd           DateTime?
  status              DonationStatus   @default(CREATED)
  isPaused            Boolean          @default(false)
  isFlagged           Boolean          @default(false)
  isHidden            Boolean          @default(false)
  requests            Request[]
  savedBy             SavedDonation[]
  reports             Report[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

// Food booking / reservation (receiver books servings from a donation)
model Request {
  id               Int           @id @default(autoincrement())
  donationId       Int
  receiverId       Int
  donation         Donation      @relation(fields: [donationId], references: [id])
  receiver         User          @relation("ReceiverRequests", fields: [receiverId], references: [id])
  status           RequestStatus @default(PENDING)
  peopleToServe    Int           @default(1)
  servingsReserved Int           @default(1)
  bookingDateTime  DateTime      @default(now())
  pickupSlot       DateTime?
  message          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  meta      String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id            Int      @id @default(autoincrement())
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entityType    String?
  entityId      Int?
  previousValue String?
  newValue      String?
  metadata      String?
  createdAt     DateTime @default(now())
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  admin      User     @relation("AdminActions", fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   Int?
  details    String?
  createdAt  DateTime @default(now())
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  level     String
  message   String
  stack     String?
  metadata  String?
  createdAt DateTime @default(now())
}

model SavedDonation {
  id         Int      @id @default(autoincrement())
  userId     Int
  donationId Int
  user       User     @relation(fields: [userId], references: [id])
  donation   Donation @relation(fields: [donationId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, donationId])
}

model Report {
  id             Int          @id @default(autoincrement())
  reporterId     Int
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])
  donationId     Int?
  donation       Donation?    @relation(fields: [donationId], references: [id])
  reportedUserId Int?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
}

enum Role {
  DONOR
  RECEIVER
  ADMIN
  SUPER_ADMIN
}

enum DonationStatus {
  CREATED
  ACTIVE
  REQUESTED
  RESERVED
  PICKED_UP
  COMPLETED
  EXPIRED
  DELETED
  INVALID
}

enum RequestStatus {
  PENDING
  CONFIRMED
  ACCEPTED
  REJECTED
  RESERVED
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  PENDING
  RESOLVED
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  purpose   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean  @default(true)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model SecurityLog {
  id        Int      @id @default(autoincrement())
  type      String
  email     String?
  userId    Int?
  message   String
  metadata  String?
  createdAt DateTime @default(now())
}

// Live session / page tracking for admin monitoring
model UserSession {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  socketId   String?
  currentPage String  @default("/")
  ip         String?
  userAgent  String?
  browser    String?
  device     String?
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  endedAt    DateTime?
}
