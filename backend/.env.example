# SQLite path is relative to backend/prisma/ — use file:./dev.db (NOT file:./prisma/dev.db)
DATABASE_URL="file:./dev.db"
JWT_SECRET="super-secret-change-me-use-32-chars-min"
PORT=5000

# Email OTP (optional — without SMTP, OTP codes print in the backend console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FoodBridge <noreply@foodbridge.local>"

